# Copy to .env.e2e (gitignored) and fill in. Never commit real values.

# Where the locally started app runs (default shown).
E2E_BASE_URL=http://localhost:8788

# Test mailbox provider that receives the real emails the app sends.
# Supported now: mailslurp. (mailosaur is not implemented yet.)
E2E_MAILBOX_PROVIDER=mailslurp

# MailSlurp (used when E2E_MAILBOX_PROVIDER=mailslurp)
MAILSLURP_API_KEY=

# Optional: how long to wait for an email, in milliseconds (default 90000).
# E2E_EMAIL_TIMEOUT_MS=90000

# Optional: learner type to pick in the "Welcome! Tell us about yourself" pop-up.
# One of: school_student (default), college_student, teacher.
# E2E_LEARNER_TYPE=school_student
